# ── DATABASE ──────────────────────────────────────────────────────────────────
# MongoDB Atlas free tier: https://cloud.mongodb.com  →  Connect → Drivers
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/invoice_db?retryWrites=true&w=majority"

# ── GOOGLE OAUTH ───────────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → Create OAuth 2.0 Client
# Authorised redirect URI must match GOOGLE_CALLBACK_URL below
GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxx"
GOOGLE_CALLBACK_URL="http://localhost:5000/auth/google/callback"

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace_with_a_long_random_string"

# ── HUGGING FACE AI CHAT BOT ───────────────────────────────────────────────────
# Free token: huggingface.co → Settings → Access Tokens → New token (read)
HUGGINGFACE_API_KEY="hf_xxxx"

# ── EMAIL (Gmail App Password) ─────────────────────────────────────────────────
# Gmail → Google Account → Security → 2-Step Verification → App Passwords
EMAIL_USER="your_email@gmail.com"
EMAIL_PASS="your_16_char_app_password"

# ── APP ────────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:5000"
FRONTEND_URL="http://localhost:3000"
PORT=5000

# ── STRIPE (Pro — auto-mark invoices paid) ────────────────────────────────────
# dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY="sk_live_xxxx"
# dashboard.stripe.com → Developers → Webhooks → Add endpoint → /webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_xxxx"

# ── TWILIO WHATSAPP (Pro — WhatsApp reminders) ─────────────────────────────────
# console.twilio.com — free trial gives you a sandbox WhatsApp number
TWILIO_ACCOUNT_SID="ACxxxx"
TWILIO_AUTH_TOKEN="xxxx"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"


# Set to your Render service URL once deployed, e.g.:
# RENDER_SELF_URL="https://invoice-automator-api.onrender.com"
RENDER_SELF_URL=""
